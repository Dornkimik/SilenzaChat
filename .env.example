PORT=3000
HOST=127.0.0.1
# First startup only: create an administrator account before opening registration.
# Username: 3-24 letters/numbers/underscores. Password: 15-128 characters.
# After creation, remove these bootstrap credentials from the environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# For public hosting, set your exact HTTPS URL and enable secure cookies.
# ORIGIN=https://chat.example.com
# SECURE_COOKIES=true
# Set NODE_ENV=production on other public hosts to require an exact HTTPS ORIGIN.
# Railway enforces this automatically. A missing/non-HTTPS ORIGIN stops startup.
# Production HTTPS responses include HSTS; verify the public edge forwards it.
# Cloudflare NEL must be disabled in Cloudflare's zone settings if unwanted.
# NODE_ENV=production
# List ONLY actual trusted ingress IPs/CIDRs and trusted intermediate proxies.
# The ingress must append/sanitize X-Forwarded-For and restrict direct access.
# Never use a trust-all network. No list means forwarding headers are ignored.
# TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# Railway needs its actual ingress networks, not the loopback example above.
# Railway: its edge connects from 100.64.0.0/10 and puts the visitor's address
# (Cloudflare's CF-Connecting-IP when proxied) in X-Real-IP. Use both lines:
# TRUSTED_PROXY_ADDRESSES=100.64.0.0/10
# CLIENT_IP_HEADER=X-Real-IP
# Other hosts behind Cloudflare that append to X-Forwarded-For can instead use:
# TRUSTED_PROXY_PRESET=cloudflare
# Temporarily set this to log one request's socket/forwarded addresses (to find
# the ingress network), then remove it again:
# LOG_CLIENT_ADDRESS_ONCE=true

# Accounts, main rooms, bans, and feedback need persistent disk storage.
# On Railway, attach a volume (for example at /data) and leave DATA_DIR unset:
# the app automatically uses RAILWAY_VOLUME_MOUNT_PATH.
# Otherwise set DATA_DIR to a directory on persistent storage.
# DATA_DIR=/data

# Encrypted attachment lifetime in seconds (1–86400); default: 24 hours.
# ATTACHMENT_TTL_SECONDS=86400
# Largest encrypted attachment (photo, video, audio or file) in MB (1–64); default: 16.
# Your reverse proxy must accept request bodies of this size.
# ATTACHMENT_MAX_MB=16
# Total memory for encrypted attachments in MB (at least ATTACHMENT_MAX_MB); default:
# 256. Each account/session and network address may use 3 x ATTACHMENT_MAX_MB of it,
# and each IPv6 /48 network 9 x ATTACHMENT_MAX_MB.
# ATTACHMENT_STORAGE_MB=256

# Seconds a new visitor cannot post links in main rooms and can start only a few
# private conversations (0–3600); default: 180.
# NEW_VISITOR_PROBATION_SECONDS=180
